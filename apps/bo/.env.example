# Copy this file to `.env.preprod` (pnpm dev, build:preprod) or `.env.prod` (build:prod).
# Never commit the real file. Every variable is inlined in the browser bundle: no secret here.
VITE_ENVIRONMENT=
VITE_SERVER_URL=
VITE_PARSE_APP_ID=
VITE_WEBSITE_URL=
# the address an admin without a role is told to write to
VITE_ADMIN_EMAIL_SENDER=
# value of the server REST_API_KEY, sent as the X-portfolio-key header
VITE_APP_ACCESS_TAG=
# on localhost the BO calls http://localhost:<this port>/parse, whatever VITE_SERVER_URL says
VITE_LOCAL_SERVER_PORT=
# set to true to keep the admin signed in while developing
VITE_DISABLE_SESSION_TIMEOUT=
# the support lines shown on the about page (placeholders are used when unset)
VITE_SUPPORT_PHONE_YAS=
VITE_SUPPORT_PHONE_AIRTEL=
VITE_SUPPORT_PHONE_ORANGE=
# error reporting (built bundles only, never `pnpm dev`): reports only when both are set. The DSN is
# public by design. Environment: preProduction | production
VITE_SENTRY_DSN=
VITE_SENTRY_ENVIRONMENT=
# SECRET, no VITE_ prefix so it never reaches the bundle: uploads the source maps at build time, from
# .env.prod / .env.preprod only (never commit a value). Without the token the build uploads nothing
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
