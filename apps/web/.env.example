# Copy this file to `.env.local` (or the file your hosting provider injects). Never commit the real file.
# Validated at build/start by env.ts.

# development | preProduction | production (set by the dev/build scripts through cross-env)
APP_ENV=

# ---- Parse server the CMS content is read from ----
PARSE_APP_ID=
# value of the server REST_API_KEY
REST_API_KEY=
SERVER_URL=

APP_URL=

# shared secret checked by /api/revalidate; while unset the endpoint rejects every call
REVALIDATE_SECRET=

# per-visitor limit of the contact and newsletter forms; while unset they are not limited
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---- exposed to the browser (never secrets) ----
NEXT_PUBLIC_SERVER_URL=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_GOOGLE_MAP_KEY=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# GA4 measurement id; unset = analytics disabled
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Sentry error reporting; unset = off. The environment is preProduction or production
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=

# ---- build time only, never exposed to the browser (source map upload) ----
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
