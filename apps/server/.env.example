# Copy this file to `.env.preprod` (local dev) or `.env.prod` (production).
# The file read is picked from NODE_ENV. Never commit the real file.
# In local, an optional `.env.local` is loaded after it and overrides it (typically SERVER_URL and
# WEBSITE_URL, e.g. http://localhost:8089 and http://localhost:9012, or your LAN ip for a phone).
PORT=
IS_PREPROD=
# ---- database ----
MONGO_URL=
# ---- Parse Server ----
PARSE_APP_ID=
PARSE_MASTER_KEY=
REST_API_KEY=
# ---- URLs ----
SERVER_URL=
WEBSITE_URL=
# optional, the agency (Aldaron) workspace: its own back-office address (a second service running this same
# code), its website and the name its e-mails are signed with. Unset, the portfolio values above are used.
# On that second service SERVER_URL must be ITS OWN url too (same value as AGENCY_SERVER_URL): the start-up
# log, Parse's serverURL and the self-ping read SERVER_URL only
AGENCY_SERVER_URL=
AGENCY_WEBSITE_URL=
AGENCY_APP_NAME=
# optional, the agency administrators: invited at boot from its own domain with the AGENCY_ADMIN role (on top of OWNERS_EMAILS)
AGENCY_OWNERS_EMAILS=
# optional, the agency's own Brevo account and the sender verified in it (set both together). Unset, the
# portfolio's BREVO_API_KEY and ADMIN_EMAIL_SENDER are used for its e-mails too
AGENCY_BREVO_API_KEY=
AGENCY_ADMIN_EMAIL_SENDER=
# optional, the agency's own Cloudinary account (set the three together). Unset, its files go to the
# portfolio's account. The `agency-logo` asset of its e-mails must exist in it
AGENCY_CLOUDINARY_NAME=
AGENCY_CLOUDINARY_API_KEY=
AGENCY_CLOUDINARY_API_SECRET=
# ---- crypto ----
CRYPTO_FIXED_PART_KEY=
CRYPTO_FIXED_FULL_KEY=
CRYPTO_IV=
# ---- e-mail (Brevo) ----
BREVO_API_KEY=
ADMIN_EMAIL_SENDER=
# comma-separated e-mail addresses that get a back-office owner invitation on boot
OWNERS_EMAILS=
# ---- files (Cloudinary) ----
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# shared secret to invalidate the website CMS cache (must match the REVALIDATE_SECRET of both websites)
WEBSITE_REVALIDATE_SECRET=
# ---- Redis (Upstash) ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_REDIS_URL=
# ---- third parties (optional locally) ----
# website contact / newsletter anti-bot check; skipped outside production
RECAPTCHA_SECRET_KEY=
# SMS provider: required in preProduction and production only (SMS are only logged elsewhere)
MMSDUCK_API_KEY=
