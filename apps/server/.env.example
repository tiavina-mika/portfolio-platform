# Copy this file to `.env.preprod` (local dev) or `.env.prod` (production).
# The file read is picked from NODE_ENV. Never commit the real file.
PORT=
IS_PREPROD=
# ---- database ----
MONGO_URL=
# ---- Parse Server ----
PARSE_APP_ID=
PARSE_MASTER_KEY=
REST_API_KEY=
# ---- URLs ----
SERVER_URL=
WEBSITE_URL=
# ---- crypto ----
CRYPTO_FIXED_PART_KEY=
CRYPTO_FIXED_FULL_KEY=
CRYPTO_IV=
# ---- e-mail (Brevo) ----
BREVO_API_KEY=
ADMIN_EMAIL_SENDER=
# comma-separated e-mail addresses that get a back-office owner invitation on boot
OWNERS_EMAILS=
# ---- files (Cloudinary) ----
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# LAN hostname/IP used to build the server URL printed for a phone on the same network
LOCAL_NETWORK_HOSTNAME=
# shared secret to invalidate the website CMS cache (must match the website REVALIDATE_SECRET)
WEBSITE_REVALIDATE_SECRET=
# ---- Redis (Upstash) ----
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
UPSTASH_REDIS_URL=
# ---- third parties (optional locally) ----
# website contact / newsletter anti-bot check; skipped outside production
RECAPTCHA_SECRET_KEY=
# SMS provider: required in preProduction and production only (SMS are only logged elsewhere)
MMSDUCK_API_KEY=
# push notifications (Expo)
EXPO_ACCESS_TOKEN=
ANDROID_SMS_RETRIEVER_HASH=
# Slack incoming webhook of the staff alert channel; leave empty to post nothing
SLACK_ALERTS_WEBHOOK_URL=
# ---- feature switches (optional) ----
# payment mocking: the accepted modes are read by the payment API
PAYMENT_MOCK_MODE=
PAYMENT_MOCK_CONFIRM_SECONDS=
# production refuses to boot while the payment gateway is the simulation; set to true by hand, for a
# deliberate demonstration only
ALLOW_MOCK_PAYMENT_GATEWAY=
