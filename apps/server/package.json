{
  "name": "portfolio-server",
  "version": "1.0.0",
  "repository": "https://github.com/tiavina-mika/portfolio-v4-server.git",
  "author": "tiavina-mika <tiavinamika@gmail.com>",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch --clear-screen=false src/index.ts",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "build": "pnpm clean && pnpm typecheck && swc src --copy-files -d dist --strip-leading-paths",
    "start": "cross-env NODE_ENV=production node --import tsx --enable-source-maps dist/index.js",
    "start:dev": "cross-env NODE_ENV=development node --import tsx --enable-source-maps dist/index.js",
    "start:preprod": "cross-env NODE_ENV=preProduction node --import tsx --enable-source-maps dist/index.js",
    "lint:check": "eslint",
    "lint": "eslint . --fix",
    "copy": "node config/copyBuilds.cjs && node config/checkClientBuildSecrets.cjs",
    "build:bo:preprod": "cd ../bo && pnpm build:preprod && cd ../server && pnpm copy",
    "build:bo": "cd ../bo && pnpm build:prod && cd ../server && cross-env NODE_ENV=production pnpm copy",
    "depcheck": "npx depcheck"
  },
  "dependencies": {
    "@getbrevo/brevo": "^6.0.2",
    "async": "^3.2.6",
    "body-parser": "^2.3.0",
    "cloudinary": "^2.10.0",
    "cors": "^2.8.6",
    "cross-env": "^10.1.0",
    "datauri": "^4.1.0",
    "dayjs": "^1.11.23",
    "dotenv": "^17.4.2",
    "envalid": "^8.2.0",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "http-status-codes": "^2.3.0",
    "i18next": "^26.5.11",
    "i18next-fs-backend": "^2.6.7",
    "i18next-http-middleware": "^3.9.8",
    "lodash": "^4.18.1",
    "multer": "^2.2.0",
    "node-cron": "^4.6.0",
    "parse-server": "^9.10.7",
    "tsx": "^4.23.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cspell/eslint-plugin": "^10.0.1",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^9.39.5",
    "@shared/eslint-config": "workspace:*",
    "@shared/prettier-config": "workspace:*",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.20",
    "@types/async": "^3.2.25",
    "@types/body-parser": "^1.19.6",
    "@types/compression": "^1.8.1",
    "@types/copyfiles": "^2.4.4",
    "@types/cors": "^2.8.19",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/express": "^5.0.6",
    "@types/lodash": "^4.17.25",
    "@types/multer": "^2.2.0",
    "@types/node": "24.13.2",
    "@types/node-cron": "^3.0.11",
    "@types/parse": "3.0.9",
    "@types/pdfkit": "^0.17.4",
    "@types/qs": "^6.15.1",
    "babel-plugin-module-resolver": "^5.0.2",
    "cspell": "^10.0.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-external-import-esm": "^1.0.9",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-lodash": "^8.0.0",
    "eslint-plugin-prefer-arrow-functions": "^3.10.1",
    "eslint-plugin-prettier": "^5.5.6",
    "fs-extra": "^11.4.0",
    "globals": "^17.9.0",
    "parse": "8.6.2",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
