{
  "name": "portfolio-v4",
  "version": "1.0.0",
  "repository": "https://github.com/tiavina-mika/portfolio-v4-server.git",
  "author": "tiavina-mika <tiavinamika@gmail.com>",
  "license": "MIT",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development tsx watch --clear-screen=false src/index.ts",
    "clean": "rimraf dist",
    "build": "npm run clean && swc src --copy-files -d dist --strip-leading-paths",
    "start": "cross-env NODE_ENV=production node --enable-source-maps dist/index.js",
    "start:dev": "cross-env NODE_ENV=development node --enable-source-maps dist/index.js",
    "start:preprod": "cross-env NODE_ENV=preProduction node --enable-source-maps dist/index.js",
    "lint:check": "eslint",
    "lint": "eslint . --fix",
    "copy": "node config/copyBuilds.cjs",
    "build:bo:preprod": "cd ../bo && npm run build:preprod && cd ../server && npm run copy",
    "build:bo": "cd ../bo && npm run build:prod && cd ../server && cross-env NODE_ENV=production npm run copy",
    "depcheck": "npx depcheck",
    "prepare": "husky",
    "lint-staged": "lint-staged"
  },
  "dependencies": {
    "@getbrevo/brevo": "^3.0.1",
    "async": "^3.2.6",
    "body-parser": "^2.2.0",
    "cloudinary": "^2.8.0",
    "cors": "^2.8.5",
    "cross-env": "^10.1.0",
    "datauri": "^4.1.0",
    "dayjs": "^1.11.19",
    "dotenv": "^17.2.3",
    "envalid": "^8.1.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "http-status-codes": "^2.3.0",
    "i18next": "^23.15.1",
    "i18next-fs-backend": "^2.3.2",
    "i18next-http-middleware": "^3.6.0",
    "lodash": "^4.17.21",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "parse-server": "^8.2.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@cspell/eslint-plugin": "^9.2.2",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.5.0",
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.38.0",
    "@stylistic/eslint-plugin": "^5.5.0",
    "@swc/cli": "^0.7.9",
    "@swc/core": "^1.15.3",
    "@types/async": "^3.2.25",
    "@types/cors": "^2.8.19",
    "@types/eslint-plugin-jsx-a11y": "^6.10.1",
    "@types/express": "^5.0.4",
    "@types/lodash": "^4.17.20",
    "@types/multer": "^2.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/parse": "3.0.9",
    "babel-plugin-module-resolver": "^5.0.2",
    "cspell": "^9.2.2",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-external-import-esm": "^1.0.9",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.0.1",
    "eslint-plugin-jsx-a11y": "^6.10.0",
    "eslint-plugin-lodash": "^8.0.0",
    "eslint-plugin-prefer-arrow-functions": "^3.9.1",
    "eslint-plugin-prettier": "^5.5.4",
    "fs-extra": "^11.3.2",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.6",
    "prettier": "^3.3.3",
    "rimraf": "^6.1.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "winston": "^3.18.3",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "engines": {
    "node": ">=18.17.0 < 21.0.0"
  },
  "packageManager": "yarn@4.10.3"
}
